# Copy this file to .env and fill in the values.
# .env is gitignored — never commit secrets.

GEMINI_API_KEY=your_gemini_api_key_here

# Database
DATABASE_URL=sqlite:///./shield.db

# Service URLs
BACKEND_URL=http://localhost:8000

# Lobster Trap (deep prompt inspection proxy)
# Run locally with `./lobstertrap serve` — defaults to port 8080.
# If unreachable, the system falls back to the offline pattern detector.
LOBSTERTRAP_URL=http://localhost:8080
LOBSTERTRAP_TIMEOUT_SEC=5

# Pinecone — vector store for RAG
# Create a free index at https://app.pinecone.io
# Index settings: dimensions=3072, metric=cosine
PINECONE_API_KEY=your_pinecone_api_key_here
PINECONE_INDEX_NAME=shield-ai

# Google Cloud Storage — uploaded contract files
# Create a bucket in GCS and set its name here.
# Locally, authenticate with: gcloud auth application-default login
# On Cloud Run, the service account needs roles/storage.objectCreator
GCS_BUCKET_NAME=your-shield-ai-uploads-bucket

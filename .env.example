# Copy this file to .env and fill in the values.
# .env is gitignored — never commit secrets.

GEMINI_API_KEY=your_gemini_api_key_here

# Database
# Local dev (SQLite fallback):
# DATABASE_URL=sqlite:///./shield.db
#
# Cloud SQL PostgreSQL (production):
# DATABASE_URL=postgresql://shield_user:password@<Cloud-SQL-Public-IP>/shield
DATABASE_URL=postgresql://shield_user:password@<Cloud-SQL-Public-IP>/shield

# Service URLs
BACKEND_URL=http://localhost:8000

# Lobster Trap (deep prompt inspection proxy)
# Use the shared Cloud Run deployment (no local setup needed):
LOBSTERTRAP_URL=https://shield-lobstertrap-aiffxvrl4q-uc.a.run.app
LOBSTERTRAP_TIMEOUT_SEC=8
# Or run locally: `./lobstertrap serve` defaults to port 8080
# LOBSTERTRAP_URL=http://localhost:8080

# Pinecone — vector store for RAG
# Create a free index at https://app.pinecone.io
# Index settings: dimensions=3072, metric=cosine
PINECONE_API_KEY=your_pinecone_api_key_here
PINECONE_INDEX_NAME=shield-ai

# Google Cloud Storage — uploaded contract files
# Create a bucket in GCS and set its name here.
#
# Auth:
#   Local dev → set GCS_SERVICE_ACCOUNT_KEY to the path of your JSON key file.
#   Cloud Run → leave GCS_SERVICE_ACCOUNT_KEY empty; Workload Identity picks
#               up the attached service account automatically (no key needed).
GCS_BUCKET_NAME=your-shield-ai-uploads-bucket
GCS_SERVICE_ACCOUNT_KEY=/path/to/shield-ai-sa-key.json
